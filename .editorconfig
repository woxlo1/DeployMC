root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kt,kts,gradle}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc,ts,tsx,js,jsx,mjs,cjs,css,html}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
